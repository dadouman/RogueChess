{
  "name": "rogue-chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "deploy": "npx wrangler deploy --config wrangler.jsonc",
    "dev": "npx http-server site -a 127.0.0.1 -p 5173 -c-1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"site/**/*.{js,css,html}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"site/**/*.{js,css,html}\" \"scripts/**/*.mjs\"",
    "poc:opening-graph": "node scripts/buildOpeningGraph.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^18.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
